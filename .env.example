# Server configuration
PORT=8080

# Database configuration
DATABASE_URL=postgres://postgres:password@localhost:5432/bank?sslmode=disable

# JWT configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# HMAC configuration (for card integrity)
HMAC_SECRET=your-hmac-secret-key-for-card-verification

# PGP configuration (for card encryption - optional)
PGP_PUBLIC_KEY=-----BEGIN PGP PUBLIC KEY BLOCK-----
# Your PGP public key here
-----END PGP PUBLIC KEY BLOCK-----

PGP_PRIVATE_KEY=-----BEGIN PGP PRIVATE KEY BLOCK-----
# Your PGP private key here
-----END PGP PRIVATE KEY BLOCK-----

PGP_PASSPHRASE=your-pgp-passphrase

# SMTP configuration (for email notifications - optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password